NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/zepter_management_demo
# Generate a unique random secret of at least 64 characters locally.
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_MB=12
# Optional push. Generate with: node -e "import('web-push').then(m=>console.log(m.default.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Used ONLY by: npm run bootstrap
BOOTSTRAP_ROLE=admin
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_FIRST_NAME=
BOOTSTRAP_LAST_NAME=
# Existing local accounts only; the company seed does not create/reset passwords.
LOCAL_TEST_PASSWORD=
# Backward-compatible local RBAC/smoke setting. Never use production credentials.
DEMO_SEED_PASSWORD=
