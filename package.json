{
  "name":"zepter-management-overview",
  "private":true,
  "version":"0.1.0",
  "engines":{"node":">=22"},
  "scripts":{
    "install:all":"npm ci --prefix server && npm ci --prefix client",
    "dev:server":"npm --prefix server run dev",
    "dev:client":"npm --prefix client run dev",
    "build:client":"npm --prefix client run build",
    "start:server":"npm --prefix server start",
    "test:server":"npm --prefix server test",
    "test:client":"npm --prefix client test",
    "check:server":"npm --prefix server run check",
    "smoke:demo":"npm --prefix server run smoke:demo",
    "smoke:company":"npm --prefix server run smoke:company",
    "test:rbac":"npm --prefix server run test:rbac",
    "bootstrap":"npm --prefix server run bootstrap",
    "seed:company":"npm --prefix server run seed:company"
  }
}
